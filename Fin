<style>
:root{--bg:#0a0e17;--panel:#111827;--panel2:#151f30;--line:#263449;--text:#e7eef8;--muted:#8ea2bd;--accent:#68d5c4;--good:#6ee7a5;--bad:#ff7b88;--warn:#f7c66a}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.45 Inter,ui-sans-serif,system-ui,Segoe UI,Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;background:#1c2a3d;color:var(--text);border:1px solid #334861;border-radius:8px;padding:9px 12px}button:hover{border-color:var(--accent)}input,select,textarea{background:#0b1320;color:var(--text);border:1px solid #2a3a50;border-radius:8px;padding:9px;min-width:0}a{color:var(--accent)}.shell{display:grid;grid-template-columns:245px minmax(0,1fr);min-height:100vh}.sidebar{background:#0d1421;border-right:1px solid var(--line);padding:18px 12px;position:sticky;top:0;height:100vh;overflow:auto}.brand{font-size:19px;font-weight:800;letter-spacing:.04em;padding:4px 9px 18px}.brand span{color:var(--accent)}.navgroup{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.12em;padding:12px 9px 5px}.navbtn{width:100%;display:flex;text-align:left;gap:10px;align-items:center;background:transparent;border-color:transparent;margin:2px 0}.navbtn.active{background:#1b2a3e;border-color:#30435a;color:#fff}.sidebar small{color:var(--muted)}main{min-width:0;padding:24px;max-width:1800px;width:100%;margin:auto}.top{display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:22px}.top h1{font-size:25px;margin:0}.subtitle{color:var(--muted);margin-top:4px}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.status{border:1px solid var(--line);border-radius:999px;padding:6px 10px;color:var(--muted);font-size:12px}.view{display:none}.view.active{display:block}.grid{display:grid;gap:14px}.grid.kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.panel{background:linear-gradient(160deg,var(--panel),#0f1724);border:1px solid var(--line);border-radius:13px;padding:16px;min-width:0}.panel h2,.panel h3{margin:0 0 12px}.panel h2{font-size:16px}.panel h3{font-size:14px}.kpi .label{color:var(--muted);font-size:12px}.kpi .value{font-size:24px;font-weight:750;margin-top:5px;overflow-wrap:anywhere}.kpi .note{font-size:12px;color:var(--muted)}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.field{display:flex;flex-direction:column;gap:5px;min-width:140px;flex:1}.field label{color:var(--muted);font-size:12px}.field input,.field select{width:100%}.formgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.tablewrap{overflow:auto;max-width:100%}table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:12px}th,td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:right}th{color:var(--muted);font-weight:600;background:#121d2c}td:first-child,th:first-child{text-align:left}canvas{width:100%;height:260px;display:block}.muted{color:var(--muted)}.positive{color:var(--good)}.negative{color:var(--bad)}.warn{color:var(--warn)}.message{padding:11px 13px;background:#102132;border:1px solid #29475b;border-radius:9px;color:#b8d7e7;margin:12px 0}.hidden{display:none!important}.pill{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:3px 8px;color:var(--muted);font-size:11px}.list{display:grid;gap:8px}.asset{display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;border-bottom:1px solid var(--line);padding:9px 0}.asset:last-child{border-bottom:0}.asset strong{display:block}.asset small{color:var(--muted)}.actions{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.footer{margin-top:28px;padding-top:15px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}.fileinput{max-width:100%}.range{display:flex;gap:8px;align-items:center}.range input{width:90px}.navtoggle{display:none}
@media(max-width:1050px){.grid.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.grid.three{grid-template-columns:repeat(2,minmax(0,1fr))}.formgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.shell{grid-template-columns:1fr}.sidebar{position:relative;height:auto;max-height:none;border-right:0;border-bottom:1px solid var(--line)}.navitems{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.navgroup{grid-column:1/-1}.sidebar .brand{padding-bottom:8px}main{padding:15px}.grid.two,.grid.three{grid-template-columns:1fr}.top h1{font-size:21px}.grid.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.kpi .value{font-size:19px}}
