<body>
<div class="shell">
<aside class="sidebar"><div class="brand">FIN<span>MODEL</span> <span class="pill">JS</span></div><small style="padding:0 9px">Public browser edition</small><div class="navitems" id="navitems">
<div class="navgroup">Workspace</div>
<button class="navbtn active" data-view="dashboard">◈ Dashboard</button>
<button class="navbtn" data-view="ticker">⌕ Ticker Analysis</button>
<button class="navbtn" data-view="market">▥ Multi-Asset Board</button>
<button class="navbtn" data-view="portfolio">◉ Portfolio Optimizer</button>
<button class="navbtn" data-view="capm">∿ CAPM / CAL / SML</button>
<div class="navgroup">Financial analysis</div>
<button class="navbtn" data-view="fundamentals">▤ Ratios & Fundamentals</button>
<button class="navbtn" data-view="model">▦ Financial Model Studio</button>
<button class="navbtn" data-view="risk">⌁ Risk Metrics</button>
<button class="navbtn" data-view="exports">⇩ Data Import / Export</button>
</div><div class="footer">No server required · Data stays in this browser unless you fetch an external source.</div></aside>
<main>
<div class="top"><div><h1 id="pageTitle">Dashboard</h1><div class="subtitle">Public quantitative workspace · JavaScript-only edition</div></div><div class="toolbar"><span class="status" id="dataStatus">Using sample data</span><button id="exportAll">Export workbook</button></div></div>
<div class="message"><b>Data note:</b> This static app does not include a private market-data key or server proxy. Use CSV/Excel import for reliable data; optional Yahoo Finance requests may fail due to browser CORS, provider changes, or rate limits. Values shown as sample data are illustrative.</div>
<section class="view active" id="view-dashboard">
<div class="grid kpis" id="dashKpis"></div>
<div class="grid two" style="margin-top:14px"><div class="panel"><h2>Sample / imported price history</h2><canvas id="dashChart"></canvas></div><div class="panel"><h2>Workspace status</h2><div class="list" id="dashStatus"></div><div class="message">Upload a CSV with columns such as <code>Date, Close</code> or <code>Date, AAPL, MSFT</code> to replace illustrative prices with your own data.</div><button data-goto="exports">Import market data</button></div></div>
<div class="panel" style="margin-top:14px"><h2>Available browser-side modules</h2><div class="grid three"><div><b>Ticker & technicals</b><p class="muted">Returns, SMA, RSI, volatility, beta, drawdown, Jensen alpha, information ratio.</p></div><div><b>Portfolio & CAPM</b><p class="muted">Long-only portfolio weights, minimum variance, tangency approximation, CAL/SML.</p></div><div><b>Financial model</b><p class="muted">DCF/FCFF, WACC, scenarios, Altman Z components and downloadable spreadsheets.</p></div></div></div>
</section>
<section class="view" id="view-ticker">
<div class="panel"><h2>Ticker Analysis</h2><div class="row"><div class="field"><label>Ticker / symbol</label><input id="ticker" value="AAPL" placeholder="AAPL, BTC-USD, EURUSD=X"></div><div class="field"><label>Benchmark symbol (in imported data)</label><input id="benchmark" value="SPY"></div><div class="field"><label>Risk-free rate (annual %)</label><input id="rf" type="number" value="4" step=".1"></div><div class="field"><label>Expected market return (%)</label><input id="marketReturn" type="number" value="9" step=".1"></div><button id="analyzeBtn" style="align-self:end">Analyze selected series</button></div>
<div class="actions"><button id="loadDemo">Load illustrative sample</button><button id="fetchYahoo">Try Yahoo Finance (may be blocked)</button><label class="pill">Import via Data Import / Export for reliable results</label></div></div>
<div class="grid kpis" id="tickerKpis" style="margin-top:14px"></div>
<div class="grid two" style="margin-top:14px"><div class="panel"><h2>Price series</h2><canvas id="tickerChart"></canvas></div><div class="panel"><h2>Returns & risk</h2><canvas id="returnsChart"></canvas></div></div>
<div class="panel" style="margin-top:14px"><h2>Technical indicators</h2><div class="tablewrap" id="technicalTable"></div></div>
<div class="panel" style="margin-top:14px"><h2>Risk and performance metrics</h2><div class="tablewrap" id="riskTable"></div></div>
</section>
<section class="view" id="view-market"><div class="panel"><h2>Multi-Asset Market Board</h2><p class="muted">Watchlist values use imported data where available; otherwise they are illustrative sample values, not live quotes.</p><div class="actions"><button id="refreshBoard">Refresh board</button><button data-goto="exports">Import prices</button></div><div class="grid three" id="marketBoard"></div></div></section>
<section class="view" id="view-portfolio">
<div class="panel"><h2>Portfolio Optimizer</h2><p class="muted">Use columns of aligned price data from your imported CSV/Excel file. Weights are long-only and sum to 100%.</p><div class="row"><div class="field"><label>Asset symbols (comma-separated)</label><input id="portSymbols" value="AAPL,MSFT,SPY"></div><div class="field"><label>Risk-free rate (%)</label><input id="portRf" type="number" value="4"></div><button id="optimizeBtn" style="align-self:end">Optimize portfolio</button></div></div>
<div class="grid kpis" id="portfolioKpis" style="margin-top:14px"></div><div class="grid two" style="margin-top:14px"><div class="panel"><h2>Suggested mathematical weights</h2><div id="weightsTable"></div></div><div class="panel"><h2>Risk / return comparison</h2><canvas id="portfolioChart"></canvas></div></div>
<div class="message">Optimization uses browser-side numerical search, historical sample returns and assumptions. It is educational analysis, not a guarantee or investment recommendation.</div>
</section>
<section class="view" id="view-capm">
<div class="panel"><h2>CAPM / CAL / SML</h2><div class="formgrid"><div class="field"><label>Risk-free rate (%)</label><input id="capmRf" type="number" value="4"></div><div class="field"><label>Expected market return (%)</label><input id="capmRm" type="number" value="9"></div><div class="field"><label>Asset beta</label><input id="capmBeta" type="number" value="1.2" step=".1"></div><div class="field"><label>Portfolio return (%)</label><input id="capmRp" type="number" value="12"></div></div><div class="actions"><button id="calcCapm">Calculate CAPM</button></div></div><div class="grid kpis" id="capmKpis" style="margin-top:14px"></div><div class="panel" style="margin-top:14px"><h2>Security Market Line</h2><canvas id="smlChart"></canvas></div></section>
<section class="view" id="view-fundamentals">
<div class="panel"><h2>Ratios & Fundamentals</h2><p class="muted">Import a company fundamentals CSV or enter values below. The browser cannot automatically retrieve every issuer's statements without a compatible public data endpoint.</p><div class="formgrid" id="fundInputs"></div><div class="actions"><button id="calcFund">Calculate ratios & Altman Z</button><button id="exportFund">Export fundamentals</button></div></div><div class="grid kpis" id="fundKpis" style="margin-top:14px"></div><div class="panel" style="margin-top:14px"><h2>Computed metrics</h2><div class="tablewrap" id="fundTable"></div></div></section>
<section class="view" id="view-model">
<div class="panel"><h2>Financial Model Studio — DCF / FCFF</h2><p class="muted">Five-year forecast and scenario analysis calculated locally in JavaScript. Enter figures in the same currency units.</p><div class="formgrid" id="modelInputs"></div><div class="actions"><button id="calcModel">Build DCF model</button><button id="exportModel">Download model workbook</button></div></div><div class="grid kpis" id="modelKpis" style="margin-top:14px"></div><div class="grid two" style="margin-top:14px"><div class="panel"><h2>Revenue / FCFF forecast</h2><canvas id="forecastChart"></canvas></div><div class="panel"><h2>Scenario valuation</h2><canvas id="scenarioChart"></canvas></div></div><div class="panel" style="margin-top:14px"><h2>Forecast detail</h2><div class="tablewrap" id="forecastTable"></div></div><div class="panel" style="margin-top:14px"><h2>WACC × terminal growth sensitivity</h2><div class="tablewrap" id="sensitivityTable"></div></div></section>
<section class="view" id="view-risk"><div class="panel"><h2>Risk Metrics</h2><p class="muted">Calculated from the currently selected ticker series and benchmark when imported.</p><div class="tablewrap" id="allRiskTable"></div><canvas id="drawdownChart"></canvas></div></section>
<section class="view" id="view-exports">
<div class="grid two"><div class="panel"><h2>Import CSV / Excel</h2><p class="muted">Price-history formats: Date + Close, or Date + one column per ticker. Fundamental CSV can be imported by selecting the fundamentals type.</p><div class="field"><label>Dataset type</label><select id="importType"><option value="prices">Price history</option><option value="fundamentals">Company fundamentals</option></select></div><div class="field" style="margin-top:10px"><label>Choose file</label><input class="fileinput" id="fileInput" type="file" accept=".csv,.xlsx,.xls"></div><div class="actions"><button id="downloadTemplate">Download CSV template</button><button id="clearData">Clear imported data</button></div><div id="importMsg" class="muted"></div></div>
<div class="panel"><h2>Export data</h2><p class="muted">Export current data, ratios, portfolio results and model outputs. Excel download uses the SheetJS CDN when available; CSV is built into the app.</p><div class="actions"><button id="exportPrices">Prices CSV</button><button id="exportAnalysis">Analysis CSV</button><button id="exportXlsx">Excel workbook</button></div><div class="message">The workbook export requires internet access to load the SheetJS library. CSV export works offline.</div></div></div>
<div class="panel" style="margin-top:14px"><h2>Imported data preview</h2><div class="tablewrap" id="dataPreview"></div></div>
<div class="panel" style="margin-top:14px"><h2>Free public deployment</h2><ol><li>Upload this folder to a GitHub repository.</li><li>In Cloudflare Pages, connect the repository.</li><li>Framework preset: None. Build command: leave blank. Build output directory: <code>/</code> or the repository root.</li><li>Deploy. Visitors use the assigned <code>pages.dev</code> URL; no Python process or backend is required.</li></ol><a href="https://pages.cloudflare.com/" target="_blank" rel="noreferrer">Cloudflare Pages</a></div></section>
<div class="footer">Finmodel JavaScript Public Edition · All browser calculations are estimates for research and education. No guarantees, personalized trade instructions, or paid data services included.</div>
</main></div>
<script>
"use strict";
const $=id=>document.getElementById(id);
const fmt=(x,d=2)=>Number.isFinite(Number(x))?Number(x).toLocaleString(undefined,{maximumFractionDigits:d,minimumFractionDigits:d}):"N/A";
const pct=x=>Number.isFinite(Number(x))?fmt(Number(x)*100,2)+"%":"N/A";
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const state={prices:{},dates:[],fundamentals:{},lastAnalysis:null,portfolio:null,model:null,importRows:[]};
const symbols=["SPY","QQQ","AAPL","MSFT","NVDA","EURUSD=X","GC=F","CL=F","BTC-USD"];
function demoSeries(seed,n=260,start=100){let x=seed>>>0,arr=[];for(let i=0;i<n;i++){x=(1664525*x+1013904223)>>>0;let z=(x/4294967296-.49)*.025;start*=1+z;arr.push(Number(start.toFixed(3)));}return arr;}
function seedDemo(){state.prices={};symbols.forEach((s,i)=>state.prices[s]=demoSeries((i+1)*7183,260,70+i*18));state.dates=Array.from({length:260},(_,i)=>{let d=new Date();d.setDate(d.getDate()-(259-i));return d.toISOString().slice(0,10)});$("dataStatus").textContent="Illustrative sample data";analyzeTicker();renderBoard();renderDashboard();}
function returns(p){let a=[];for(let i=1;i<p.length;i++)a.push(p[i-1]?p[i]/p[i-1]-1:0);return a.filter(Number.isFinite)}
function mean(a){return a.length?a.reduce((s,x)=>s+x,0)/a.length:NaN}
function variance(a){if(a.length<2)return NaN;let m=mean(a);return a.reduce((s,x)=>s+(x-m)**2,0)/(a.length-1)}
function sd(a){return Math.sqrt(variance(a))}
function cov(a,b){let n=Math.min(a.length,b.length);if(n<2)return NaN;let aa=a.slice(-n),bb=b.slice(-n),ma=mean(aa),mb=mean(bb);return aa.reduce((s,x,i)=>s+(x-ma)*(bb[i]-mb),0)/(n-1)}
function beta(a,b){let v=variance(b);return v?cov(a,b)/v:NaN}
function sma(p,n){return p.length>=n?mean(p.slice(-n)):NaN}
function rsi(p,n=14){if(p.length<=n)return NaN;let gains=0,loss=0;for(let i=p.length-n;i<p.length;i++){let d=p[i]-p[i-1];if(d>0)gains+=d;else loss-=d;}return loss===0?100:100-100/(1+(gains/n)/(loss/n))}
function maxDrawdown(p){let peak=-Infinity,mdd=0;for(let x of p){peak=Math.max(peak,x);mdd=Math.min(mdd,x/peak-1)}return mdd}
function chart(id,series){let c=$(id);if(!c)return;let ctx=c.getContext("2d"),w=c.clientWidth||500,h=260,dpr=window.devicePixelRatio||1;c.width=w*dpr;c.height=h*dpr;ctx.scale(dpr,dpr);ctx.clearRect(0,0,w,h);ctx.strokeStyle="#263449";ctx.lineWidth=1;for(let i=1;i<5;i++){let y=h*i/5;ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke()}let all=series.flatMap(s=>s.values.filter(Number.isFinite));if(!all.length)return;let min=Math.min(...all),max=Math.max(...all);if(max===min)max=min+1;let pad={l:42,r:12,t:12,b:22};const X=i=>pad.l+i/(Math.max(...series.map(s=>s.values.length))-1||1)*(w-pad.l-pad.r),Y=v=>h-pad.b-(v-min)/(max-min)*(h-pad.t-pad.b);ctx.fillStyle="#8ea2bd";ctx.font="10px sans-serif";ctx.fillText(fmt(max,2),4,14);ctx.fillText(fmt(min,2),4,h-24);series.forEach((s,k)=>{ctx.strokeStyle=["#68d5c4","#7ba7ff","#f7c66a","#e68de2","#ff7b88"][k%5];ctx.lineWidth=2;ctx.beginPath();s.values.forEach((v,i)=>{if(!Number.isFinite(v))return;let x=X(i),y=Y(v);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)});ctx.stroke()})}
function table(headers,rows){return `<table><thead><tr>${headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map((v,i)=>`<td>${i===0?esc(v):esc(v)}</td>`).join("")}</tr>`).join("")}</tbody></table>`}
function kpi(label,value,note=""){return `<div class="panel kpi"><div class="label">${esc(label)}</div><div class="value">${esc(value)}</div><div class="note">${esc(note)}</div></div>`}
function activeSymbol(){return ($("ticker").value||"AAPL").trim().toUpperCase()}
function getPrices(s){return state.prices[s]||null}
function analyzeTicker(){let s=activeSymbol(),p=getPrices(s);if(!p){$("tickerKpis").innerHTML=kpi("No series","N/A","Import price data first");return}let r=returns(p),bench=getPrices(($("benchmark").value||"SPY").toUpperCase()),br=bench?returns(bench):[],n=Math.min(r.length,br.length),ar=r.slice(-n),brr=br.slice(-n),b= n>2?beta(ar,brr):NaN,rf=Number($("rf").value)/100,rm=Number($("marketReturn").value)/100,ann=mean(r)*252,vol=sd(r)*Math.sqrt(252),alpha=ann-(rf+b*(mean(brr)*252-rf)),active=n>2?mean(ar.map((x,i)=>x-brr[i]))*252:NaN,te=n>2?sd(ar.map((x,i)=>x-brr[i]))*Math.sqrt(252):NaN,ir=active/te;
let mdd=maxDrawdown(p),last=p[p.length-1],chg=p.length>1?last/p[p.length-2]-1:NaN,tech=[["Last price",fmt(last)],["Daily change",pct(chg)],["SMA 20",fmt(sma(p,20))],["SMA 50",fmt(sma(p,50))],["RSI 14",fmt(rsi(p),1)],["Annualized volatility",pct(vol)],["Maximum drawdown",pct(mdd)]],risk=[["Annualized return (arithmetic)",pct(ann)],["Annualized volatility",pct(vol)],["Beta vs selected benchmark",fmt(b,3)],["Jensen alpha (annualized)",pct(alpha)],["Active return (annualized)",pct(active)],["Tracking error (annualized)",pct(te)],["Information ratio",fmt(ir,3)],["Maximum drawdown",pct(mdd)],["Observations",r.length]];
state.lastAnalysis={symbol:s,last,change:chg,annualReturn:ann,volatility:vol,beta:b,alpha,active,trackingError:te,informationRatio:ir,maxDrawdown:mdd,technical:tech,risk};
$("tickerKpis").innerHTML=[kpi("Last price",fmt(last),s),kpi("Daily change",pct(chg)),kpi("Annualized return",pct(ann)),kpi("Annualized volatility",pct(vol))].join("");
$("technicalTable").innerHTML=table(["Indicator","Value"],tech);$("riskTable").innerHTML=table(["Metric","Value"],risk);chart("tickerChart",[{name:s,values:p}]);chart("returnsChart",[{name:"Returns",values:r.map(x=>x*100)}]);$("allRiskTable").innerHTML=table(["Metric","Value"],risk);chart("drawdownChart",[{name:"Drawdown",values:drawdowns(p).map(x=>x*100)}]);renderDashboard();}
function drawdowns(p){let peak=-Infinity;return p.map(x=>{peak=Math.max(peak,x);return x/peak-1})}
function renderDashboard(){let s=activeSymbol(),p=getPrices(s)||[];let a=state.lastAnalysis;$("dashKpis").innerHTML=[kpi("Selected asset",s,"Browser-side analysis"),kpi("Latest value",fmt(p.at(-1)), "Imported or illustrative"),kpi("Daily change",pct(p.length>1?p.at(-1)/p.at(-2)-1:NaN)),kpi("Max drawdown",pct(p.length?maxDrawdown(p):NaN))].join("");chart("dashChart",[{name:s,values:p}]);$("dashStatus").innerHTML=[["Data mode",$("dataStatus").textContent],["Imported series",Object.keys(state.prices).length],["Price observations",p.length],["ML mode","JavaScript regression approximation"]].map(x=>`<div class="asset"><div><strong>${esc(x[0])}</strong></div><span>${esc(x[1])}</span></div>`).join("")}
function renderBoard(){let html=symbols.map(s=>{let p=getPrices(s);if(!p)return `<div class="panel"><b>${esc(s)}</b><p class="muted">No imported series</p><button onclick="loadSymbol('${esc(s)}')">Analyze</button></div>`;let ch=p.at(-1)/p.at(-2)-1;return `<div class="panel"><div class="row" style="justify-content:space-between"><b>${esc(s)}</b><span class="pill">sample/imported</span></div><div style="font-size:22px;font-weight:750;margin:10px 0">${fmt(p.at(-1))}</div><div class="${ch>=0?'positive':'negative'}">${pct(ch)} daily</div><div class="actions"><button onclick="loadSymbol('${esc(s)}')">Analyze</button></div></div>`}).join("");$("marketBoard").innerHTML=html}
