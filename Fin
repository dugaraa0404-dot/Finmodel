function loadImportedRows(rows){state.importRows=rows;if(!rows.length)return;let headers=Object.keys(rows[0]),dateCol=headers.find(h=>/^date|time|timestamp$/i.test(h));let numeric=headers.filter(h=>h!==dateCol&&rows.some(r=>Number.isFinite(Number(r[h]))));if($("importType").value==="fundamentals"){state.fundamentals=Object.fromEntries(rows.map(r=>[String(r.metric||r.Metric||r.name||r.Name||Object.keys(r)[0]).toLowerCase(),Number(r.value??r.Value??r.amount)]));initFundInputs(true);calcFund();$("importMsg").textContent="Imported fundamentals data.";return}
