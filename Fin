function initModelInputs(){if($("modelInputs").dataset.ready)return;let f=[["revenue","Current revenue",1000],["ebitMargin","EBIT margin (%)",12],["tax","Tax rate (%)",20],["growth","Annual revenue growth (%)",6],["capex","Capex (% revenue)",4],["da","D&A (% revenue)",3],["nwc","Change in NWC (% revenue)",1],["wacc","WACC (%)",9],["terminal","Terminal growth (%)",2.5],["cash","Cash",100],["debt","Debt",250],["shares","Shares outstanding",100],["price","Current share price",15]];$("modelInputs").innerHTML=f.map(([id,l,v])=>`<div class="field"><label>${l}</label><input id="m_${id}" type="number" value="${v}" step=".1"></div>`).join("");$("modelInputs").dataset.ready="1"}
function calcModel(){let g=id=>Number($("m_"+id).value||0),rev0=g("revenue"),margin=g("ebitMargin")/100,tax=g("tax")/100,growth=g("growth")/100,capex=g("capex")/100,da=g("da")/100,nwc=g("nwc")/100,wacc=g("wacc")/100,tg=g("terminal")/100,cash=g("cash"),debt=g("debt"),shares=g("shares"),price=g("price");if(wacc<=tg){alert("WACC must be greater than terminal growth.");return}let rows=[["Year","Revenue","Revenue Growth","EBIT","NOPAT","D&A","Capex","Change NWC","FCFF","Discount factor","PV FCFF"]],f=[],pv=0,rev=rev0;for(let y=1;y<=5;y++){rev*=1+growth;let ebit=rev*margin,nopat=ebit*(1-tax),d=rev*da,c=rev*capex,n=rev*nwc,fcff=nopat+d-c-n,df=1/(1+wacc)**y,p=fcff*df;pv+=p;f.push({y,rev,fcff,ebit});rows.push([y,rev,growth,ebit,nopat,d,c,n,fcff,df,p])}let tv=f[4].fcff*(1+tg)/(wacc-tg),pvtv=tv/(1+wacc)**5,ev=pv+pvtv,equity=ev+cash-debt,per=equity/shares;state.model={rows,forecast:f,wacc,tg,ev,equity,per};$("modelKpis").innerHTML=[kpi("Enterprise value",fmt(ev), "Model currency units"),kpi("Equity value",fmt(equity)),kpi("DCF per share",fmt(per)),kpi("Implied upside",pct(per/price-1))].join("");$("forecastTable").innerHTML=table(rows[0],rows.slice(1).map(r=>r.map((v,i)=>i===0?v:fmt(v))));chart("forecastChart",[{name:"Revenue",values:f.map(x=>x.rev)},{name:"FCFF",values:f.map(x=>x.fcff)}]);let sc=[["Bear",growth-.03,margin-.03,wacc+.02],["Base",growth,margin,wacc],["Bull",growth+.03,margin+.03,Math.max(wacc-.01,tg+.01)]].map(([n,gr,ma,wa])=>{let rr=rev0,pp=0,ff=0;for(let y=1;y<=5;y++){rr*=1+gr;ff=rr*ma*(1-tax)+rr*da-rr*capex-rr*nwc;pp+=ff/(1+wa)**y}let tvv=ff*(1+tg)/(wa-tg),value=(pp+tvv/(1+wa)**5+cash-debt)/shares;return[n,value]});chart("scenarioChart",[{name:"Per share",values:sc.map(x=>x[1])}]);$("sensitivityTable").innerHTML=table(["WACC \\ Terminal growth",...[-.01,0,.005,.01].map(x=>pct(tg+x))],[.01,.02,.03].map(delta=>[pct(wacc+delta),...[-.01,0,.005,.01].map(x=>{let wa=wacc+delta,gt=tg+x;if(wa<=gt)return"N/A";let val=f.reduce((s,v)=>s+v.fcff/(1+wa)**v.y,0)+f[4].fcff*(1+gt)/(wa-gt)/(1+wa)**5;return fmt((val+cash-debt)/shares)})]));}
