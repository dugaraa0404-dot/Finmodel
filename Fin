function calcCapm(){let rf=Number($("capmRf").value)/100,rm=Number($("capmRm").value)/100,b=Number($("capmBeta").value),rp=Number($("capmRp").value)/100,req=rf+b*(rm-rf);$("capmKpis").innerHTML=[kpi("CAPM expected return",pct(req)),kpi("Portfolio return",pct(rp)),kpi("Jensen alpha",pct(rp-req)),kpi("Market risk premium",pct(rm-rf))].join("");chart("smlChart",[{name:"SML",values:Array.from({length:11},(_,i)=>(rf+(i*.25)*(rm-rf))*100)}])}
