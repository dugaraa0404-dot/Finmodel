function renderPortfolio(){let ss=$("portSymbols").value.split(",").map(s=>s.trim().toUpperCase()).filter(Boolean),avail=ss.filter(s=>getPrices(s));if(!avail.length){$("portfolioKpis").innerHTML=kpi("No imported assets","N/A","Import multiple price columns");return}let rr=avail.map(s=>returns(getPrices(s))),n=Math.min(...rr.map(a=>a.length));rr=rr.map(a=>a.slice(-n));let mu=rr.map(a=>mean(a)*252),covm=rr.map(a=>rr.map(b=>cov(a,b)*252)),rf=Number($("portRf").value)/100;let best={score:Infinity,w:[]};for(let t=0;t<15000;t++){let w=avail.map(()=>Math.random());let sum=w.reduce((a,b)=>a+b,0);w=w.map(x=>x/sum);let ret=w.reduce((s,x,i)=>s+x*mu[i],0),v=Math.sqrt(w.reduce((s,x,i)=>s+w.reduce((q,y,j)=>q+x*y*covm[i][j],0),0));let score=ret>rf? v/(ret-rf):v+Math.abs(ret-rf);if(score<best.score)best={score,w,ret,v}}let rows=avail.map((s,i)=>[s,pct(best.w[i]),pct(mu[i]),pct(Math.sqrt(covm[i][i]))]);state.portfolio={rows:[["Asset","Weight","Annual return","Annual volatility"],...rows],weights:best.w,ret:best.ret,vol:best.v};$("portfolioKpis").innerHTML=[kpi("Expected annual return",pct(best.ret)),kpi("Annualized volatility",pct(best.v)),kpi("Sharpe ratio",fmt((best.ret-rf)/best.v,3)),kpi("Assets",avail.length)].join("");$("weightsTable").innerHTML=table(["Asset","Weight","Annual return","Annual volatility"],rows);chart("portfolioChart",[{name:"Weights",values:best.w.map(x=>x*100)},{name:"Returns",values:mu.map(x=>x*100)}])}
