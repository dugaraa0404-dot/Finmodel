$("fetchYahoo").onclick=async()=>{let s=activeSymbol();$("dataStatus").textContent="Trying Yahoo Finance…";try{let u=`https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(s)}?range=1y&interval=1d`;let r=await fetch(u);if(!r.ok)throw Error("HTTP "+r.status);let j=await r.json(),res=j.chart.result?.[0];if(!res)throw Error("No chart data returned");let p=res.indicators.quote[0].close.filter(Number.isFinite);if(p.length<3)throw Error("Insufficient observations");state.prices[s]=p;state.dates=res.timestamp.map(t=>new Date(t*1000).toISOString().slice(0,10));$("dataStatus").textContent="Yahoo data loaded";analyzeTicker();renderBoard()}catch(e){$("dataStatus").textContent="Import required";alert("Yahoo request failed in the browser. Provider CORS, symbol coverage, or rate limits may block it. Import a CSV instead. Details: "+e.message)}};
function initFundInputs(imported=false){let fields=[["revenue","Revenue",1000],["ebit","EBIT",120],["netIncome","Net income",80],["totalAssets","Total assets",900],["totalLiabilities","Total liabilities",450],["currentAssets","Current assets",300],["currentLiabilities","Current liabilities",180],["retainedEarnings","Retained earnings",120],["marketEquity","Market value of equity",700],["sales","Sales",1000],["workingCapital","Working capital",120],["totalDebt","Total debt",220],["equity","Book equity",450],["ebitda","EBITDA",150]];if(!imported&&!$("fundInputs").dataset.ready){$("fundInputs").innerHTML=fields.map(([id,label,val])=>`<div class="field"><label>${label}</label><input id="f_${id}" type="number" value="${val}"></div>`).join("");$("fundInputs").dataset.ready="1"}}
function calcFund(){let g=id=>Number($("f_"+id)?.value||0),rev=g("revenue"),ebit=g("ebit"),ni=g("netIncome"),assets=g("totalAssets"),liab=g("totalLiabilities"),ca=g("currentAssets"),cl=g("currentLiabilities"),re=g("retainedEarnings"),me=g("marketEquity"),sales=g("sales"),wc=g("workingCapital"),debt=g("totalDebt"),eq=g("equity"),ebitda=g("ebitda");let z=assets&&liab?1.2*(wc/assets)+1.4*(re/assets)+3.3*(ebit/assets)+.6*(me/liab)+1*(sales/assets):NaN;let metrics=[["Revenue growth", "Import multiple years to calculate"],["EBIT margin",pct(ebit/rev)],["Net margin",pct(ni/rev)],["ROA",pct(ni/assets)],["ROE",pct(ni/eq)],["Current ratio",fmt(ca/cl)],["Debt / Equity",fmt(debt/eq)],["Asset turnover",fmt(sales/assets)],["Altman Z (classic public manufacturing formula)",fmt(z,3)],["Z-score zone",z>2.99?"Safe":z>=1.81?"Grey":"Distress"]];state.fundamentals=Object.fromEntries(metrics.map(x=>[x[0],x[1]]));$("fundKpis").innerHTML=[kpi("EBIT margin",pct(ebit/rev)),kpi("Net margin",pct(ni/rev)),kpi("Debt / Equity",fmt(debt/eq)),kpi("Altman Z",fmt(z,3))].join("");$("fundTable").innerHTML=table(["Metric","Value"],metrics)}
